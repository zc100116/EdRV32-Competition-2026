# File: edrv32_fpga_cpu_sys_top_probe.fdc
# Timing-only P2/P3 overlay; load alongside edrv32_fpga_cpu_sys_top.fdc.
# CANDIDATE syntax: Windows PDS must confirm attribute names, object selectors,
# hierarchy separators and that all six distinct FF/Q nets survive synthesis.
# Local vendor IP uses syn_preserve=1 on FFs and syn_keep=1 on nets, but the
# available PDS quick guide does not document their external FDC form or whether
# syn_preserve alone prevents identical-register merging. Apply both candidates.
# No RTL vendor attributes and no conditional/ignored constraint commands.

define_attribute {i:u_cpu_subsys.u_core.u_frontend.probe_predictor_redirect_valid_r} {syn_preserve} {1}
define_attribute {n:u_cpu_subsys.u_core.u_frontend.probe_predictor_redirect_valid_r} {syn_keep} {1}
define_attribute {i:u_cpu_subsys.u_core.u_frontend.probe_predictor_d_redirect_valid_r} {syn_preserve} {1}
define_attribute {n:u_cpu_subsys.u_core.u_frontend.probe_predictor_d_redirect_valid_r} {syn_keep} {1}
define_attribute {i:u_cpu_subsys.u_core.u_frontend.probe_f1_redirect_valid_r} {syn_preserve} {1}
define_attribute {n:u_cpu_subsys.u_core.u_frontend.probe_f1_redirect_valid_r} {syn_keep} {1}
define_attribute {i:u_cpu_subsys.u_core.u_frontend.probe_f1_d_redirect_valid_r} {syn_preserve} {1}
define_attribute {n:u_cpu_subsys.u_core.u_frontend.probe_f1_d_redirect_valid_r} {syn_keep} {1}
define_attribute {i:u_cpu_subsys.u_core.u_frontend.probe_ib_redirect_valid_r} {syn_preserve} {1}
