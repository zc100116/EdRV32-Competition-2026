# File: edrv32_npu_timing_probe.fdc
# Card 57 timing-only probe; change this period for 175 MHz intermediate acceptance.
set npu_period_ns 5.000
create_clock -name {clk_npu} [get_ports {clk_i}] -period $npu_period_ns \
    -waveform [list 0 [expr {$npu_period_ns / 2.0}]]
set_clock_uncertainty 0.150 -from [get_clocks {clk_npu}] -to [get_clocks {clk_npu}] -setup
set_false_path -from [get_ports {rst_n_i scan_i}]
set_false_path -to [get_ports {scan_o}]
define_attribute {p:clk_i} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk_i} {PAP_IO_LOC} {D18}
define_attribute {p:clk_i} {PAP_IO_VCCIO} {3.3}
