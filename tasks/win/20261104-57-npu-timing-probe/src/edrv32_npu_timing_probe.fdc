# File: edrv32_npu_timing_probe.fdc
# Card 57: timing-only constraints. R1/R2 use clk_npu 5.000 ns (200 MHz); clk_mem stays
# 8.000 ns (125 MHz) as on the board. Edit only the clk_npu period/waveform pair if asked.
create_clock -name {clk_npu} [get_ports {clk_npu_i}] -period {5.000} -waveform {0 2.500}
create_clock -name {clk_mem} [get_ports {clk_mem_i}] -period {8.000} -waveform {0 4.000}
set_clock_uncertainty {0.15} -from [get_clocks {clk_npu}] -to [get_clocks {clk_npu}] -setup
set_clock_uncertainty {0.15} -from [get_clocks {clk_mem}] -to [get_clocks {clk_mem}] -setup
# Same relation as fpga/constraints/edrv32_fpga_board_full_top.fdc: CDC primitives only.
set_clock_groups -asynchronous -group [get_clocks {clk_mem}] -group [get_clocks {clk_npu}]
# Probe pins are test access only; internal paths stay fully constrained.
set_false_path -from [get_ports {rst_n_i scan_i}]
set_false_path -to [get_ports {scan_o irq_scan_o}]

define_attribute {p:clk_npu_i} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk_npu_i} {PAP_IO_LOC} {D18}
define_attribute {p:clk_npu_i} {PAP_IO_VCCIO} {3.3}
