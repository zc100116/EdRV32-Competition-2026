# PG2L200H CoreMark board: 27-MHz oscillator and 100-MHz SoC PLL.
create_clock -name {clk_27m} [get_ports {clk_27m_i}] -period {37.037} -waveform {0.000 18.519}
create_generated_clock -name {soc_clk} -source [get_ports {clk_27m_i}] [get_pins {u_soc_pll/clkout0}] -master_clock [get_clocks {clk_27m}] -multiply_by {100} -divide_by {27}
