# File: edrv32_fpga_board_vision_top.fdc
# Spec: edrv32-soc-spec 5.2 X1-X8; vendor ov5640, Ethernet and DDR3 demos.
# Related video clocks remain timed together. No exception cuts DDR PHY clocks
# from core_clk. Vendor PHY clocks/placement are reproduced below for u_ddr3.
create_clock -name {clk_board} [get_ports {clk_i}] -period {37.037037} -waveform {0 18.518519}
create_clock -name {clk_ddr_ref} [get_ports {ddr_ref_clk_p_i}] -period {8} -waveform {0 4}
create_clock -name {clk_cam0} [get_ports {cam0_pclk_i}] -period {10} -waveform {0 5}
create_clock -name {clk_cam1} [get_ports {cam1_pclk_i}] -period {10} -waveform {0 5}
create_clock -name {clk_rgmii_ref} [get_ports {rgmii_rxc_i}] -period {8} -waveform {0 4}
create_generated_clock -name {clk_sys} -source [get_ports {clk_i}] [get_pins {u_pll_sys/clkout0}] -multiply_by {100} -divide_by {27}
create_generated_clock -name {clk_pix} -source [get_ports {clk_i}] [get_pins {u_pll_video/clkout0}] -multiply_by {11} -divide_by {4}
create_generated_clock -name {clk_serial} -source [get_ports {clk_i}] [get_pins {u_pll_video/clkout1}] -multiply_by {55} -divide_by {4}
# DDR PHY clocks, timing and physical placement from vendor pnr/ddr_test.fdc.
create_generated_clock -name {rst_clk} -source [get_ports {ddr_ref_clk_p_i}] [get_pins {u_ddr3.u_ddrphy_top.rst_clk_gpll/clkout0}] -master_clock [get_clocks {clk_ddr_ref}] -multiply_by {16} -divide_by {16}
create_generated_clock -name {clk_mem} -source [get_ports {ddr_ref_clk_p_i}] [get_pins {u_ddr3.u_ddrphy_top.ddrphy_gpll/clkout0}] -master_clock [get_clocks {clk_ddr_ref}] -multiply_by {16} -divide_by {16}
create_generated_clock -name {phy_dq_clk_0} -source [get_ports {ddr_ref_clk_p_i}] [get_pins {u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {clk_ddr_ref}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_0} -source [get_pins {u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] [get_pins {u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_0}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks clk_mem] -to [get_clocks phy_dq_sysclk_0]
create_generated_clock -name {phy_dq_clk_1} -source [get_ports {ddr_ref_clk_p_i}] [get_pins {u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {clk_ddr_ref}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_1} -source [get_pins {u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] [get_pins {u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_1}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks clk_mem] -to [get_clocks phy_dq_sysclk_1]
set_clock_uncertainty {0.4} -from [get_clocks {clk_mem}] -to [get_clocks {phy_dq_sysclk_0}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_0}] -to [get_clocks {clk_mem}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {clk_mem}] -to [get_clocks {phy_dq_sysclk_1}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_1}] -to [get_clocks {clk_mem}] -setup -hold
# Vendor 2_9_ddr3_test ddr_test.fdc: the DDR IP reset and DQ PHY clocks are
# asynchronous to every other clock (IP-internal reset synchronization).
set_clock_groups -name rst_clk -asynchronous -group [get_clocks {rst_clk}]
set_clock_groups -name phy_dq_clk_0 -asynchronous -group [get_clocks {phy_dq_clk_0}]
set_clock_groups -name phy_dq_clk_1 -asynchronous -group [get_clocks {phy_dq_clk_1}]
define_attribute {i:u_ddr3.u_ddrphy_top.u_ddrphy_cpd} {PAP_LOC} {DDRPHY_CPD_729_772}
define_attribute {i:u_ddr3.u_ddrphy_top.ddrphy_reset_ctrl.ddrphy_ioclk_gate[0]} {PAP_LOC} {CLMA_717_672:FF3}
define_attribute {i:u_ddr3.u_ddrphy_top.ddrphy_reset_ctrl.ddrphy_ioclk_gate[1]} {PAP_LOC} {CLMA_717_978:FF3}
# Vendor ref_clock.idf: CLKOUT0 phase 30 deg = 2/3 ns at 125 MHz.
create_generated_clock -name {clk_eth} -source [get_ports {rgmii_rxc_i}] [get_pins {u_rgmii/u_pll_eth/clkout0}] -edges {1 2 3} -edge_shift {0.666667 0.666667 0.666667}
create_generated_clock -name {clk_rgmii_tx} -source [get_pins {u_rgmii/u_pll_eth/clkout0}] [get_ports {rgmii_txc_o}] -edges {1 2 3} -edge_shift {1 1 1}

# X1/X2 sys<->mem, X3 IRQ, X4 cameras, X5/X6 display, X7 ETH.
# Pairwise groups list only SoC-facing clocks; DDR PHY groups follow the vendor example above.
set_clock_groups -asynchronous -group [get_clocks {clk_sys}] -group [get_clocks {clk_mem}]
set_clock_groups -asynchronous -group [get_clocks {clk_sys}] -group [get_clocks {clk_pix clk_serial}]
set_clock_groups -asynchronous -group [get_clocks {clk_sys}] -group [get_clocks {clk_cam0}]
set_clock_groups -asynchronous -group [get_clocks {clk_sys}] -group [get_clocks {clk_cam1}]
set_clock_groups -asynchronous -group [get_clocks {clk_sys}] -group [get_clocks {clk_eth clk_rgmii_tx}]
set_clock_groups -asynchronous -group [get_clocks {clk_mem}] -group [get_clocks {clk_pix clk_serial}]
set_clock_groups -asynchronous -group [get_clocks {clk_mem}] -group [get_clocks {clk_cam0}]
set_clock_groups -asynchronous -group [get_clocks {clk_mem}] -group [get_clocks {clk_cam1}]
set_clock_groups -asynchronous -group [get_clocks {clk_mem}] -group [get_clocks {clk_eth clk_rgmii_tx}]
set_clock_groups -asynchronous -group [get_clocks {clk_pix clk_serial}] -group [get_clocks {clk_cam0}]
set_clock_groups -asynchronous -group [get_clocks {clk_pix clk_serial}] -group [get_clocks {clk_cam1}]
set_clock_groups -asynchronous -group [get_clocks {clk_pix clk_serial}] -group [get_clocks {clk_eth clk_rgmii_tx}]
set_clock_groups -asynchronous -group [get_clocks {clk_cam0}] -group [get_clocks {clk_cam1}]
set_clock_groups -asynchronous -group [get_clocks {clk_cam0}] -group [get_clocks {clk_eth clk_rgmii_tx}]
set_clock_groups -asynchronous -group [get_clocks {clk_cam1}] -group [get_clocks {clk_eth clk_rgmii_tx}]
# X8 asynchronous assertion; reset_ctrl owns synchronized release and mem_ready CDC.
set_false_path -from [get_ports {rst_n_i}]
# External asynchronous peripheral inputs enter SoC synchronizers.
set_false_path -from [get_ports {key_n_i[*] uart_rx_i i2c0_scl_o[*] i2c0_sda_o[*] eth_mdio_o}]

