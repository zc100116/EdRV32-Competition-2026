# File: edrv32_fpga_npu_top.fdc
# Top: edrv32_fpga_npu_top (npu-plan N-W2).
# Measurement only, not run on the board. clk_npu_i is the 27 MHz board clock on D18,
# constrained at the clk_npu development target 150 MHz (npu-spec 9 item 1); clk_mem_i
# enters on K21, the clock-capable HDMI-in pixel clock pin of the vendor HDMI demos
# (B24 was rejected by PnR Place-0084 in 20261028-01), and is constrained at
# 125 MHz (SoC spec 5.1). The two clocks are asynchronous (SoC spec 5.1); their only
# crossings are the APB/AXI256 asynchronous bridges inside edrv32_npu (SoC 5.2 X9, X10).
# Other pins reuse edrv32_fpga_cpu_sys_top.fdc: rst_n_i on key C22, stim_i on key C23,
# obs_o on LED A20, irq_obs_o on LED C18.

create_clock -name {clk_npu} [get_ports {clk_npu_i}] -period {6.667} -waveform {0.000 3.333}
create_clock -name {clk_mem} [get_ports {clk_mem_i}] -period {8.000} -waveform {0.000 4.000}
set_clock_groups -name {npu_mem_async} -asynchronous -group [get_clocks {clk_npu}] -group [get_clocks {clk_mem}]

define_attribute {p:clk_npu_i} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk_npu_i} {PAP_IO_LOC} {D18}
define_attribute {p:clk_npu_i} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk_npu_i} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk_npu_i} {PAP_IO_NONE} {TRUE}

define_attribute {p:clk_mem_i} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk_mem_i} {PAP_IO_LOC} {K21}
define_attribute {p:clk_mem_i} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk_mem_i} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk_mem_i} {PAP_IO_NONE} {TRUE}

define_attribute {p:rst_n_i} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:rst_n_i} {PAP_IO_LOC} {C22}
define_attribute {p:rst_n_i} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rst_n_i} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rst_n_i} {PAP_IO_NONE} {TRUE}

define_attribute {p:stim_i} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:stim_i} {PAP_IO_LOC} {C23}
define_attribute {p:stim_i} {PAP_IO_VCCIO} {3.3}
define_attribute {p:stim_i} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:stim_i} {PAP_IO_NONE} {TRUE}

define_attribute {p:obs_o} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:obs_o} {PAP_IO_LOC} {A20}
define_attribute {p:obs_o} {PAP_IO_VCCIO} {3.3}
define_attribute {p:obs_o} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:obs_o} {PAP_IO_DRIVE} {8}
define_attribute {p:obs_o} {PAP_IO_NONE} {TRUE}
define_attribute {p:obs_o} {PAP_IO_SLEW} {SLOW}

define_attribute {p:irq_obs_o} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:irq_obs_o} {PAP_IO_LOC} {C18}
define_attribute {p:irq_obs_o} {PAP_IO_VCCIO} {3.3}
define_attribute {p:irq_obs_o} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:irq_obs_o} {PAP_IO_DRIVE} {8}
define_attribute {p:irq_obs_o} {PAP_IO_NONE} {TRUE}
define_attribute {p:irq_obs_o} {PAP_IO_SLEW} {SLOW}
