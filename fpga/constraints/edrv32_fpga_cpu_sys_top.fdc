# File: edrv32_fpga_cpu_sys_top.fdc
# Top: edrv32_fpga_cpu_sys_top (task 20261025-01-cpu-sys-synth, cpu-plan C-W2).
# clk_i is the 27 MHz board clock on D18 but is constrained at the clk_sys target
# 150 MHz: this build only measures timing and resources and is not run on the board.
# Pins and IO attributes follow the vendor demos: clk/led/uart from
# 2_Demo/2_8_uart_test/uart_test.fdc, rstn (C22) and key (C23) from
# 2_Demo/2_7_key_led_test/source/key_led_test.fdc.

create_clock -name {clk_sys} [get_ports {clk_i}] -period {6.667} -waveform {0.000 3.333}

define_attribute {p:clk_i} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk_i} {PAP_IO_LOC} {D18}
define_attribute {p:clk_i} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk_i} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk_i} {PAP_IO_NONE} {TRUE}

define_attribute {p:rst_n_i} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:rst_n_i} {PAP_IO_LOC} {C22}
define_attribute {p:rst_n_i} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rst_n_i} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rst_n_i} {PAP_IO_NONE} {TRUE}

define_attribute {p:key_n_i} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:key_n_i} {PAP_IO_LOC} {C23}
define_attribute {p:key_n_i} {PAP_IO_VCCIO} {3.3}
define_attribute {p:key_n_i} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:key_n_i} {PAP_IO_NONE} {TRUE}

define_attribute {p:uart_rx_i} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:uart_rx_i} {PAP_IO_LOC} {B24}
define_attribute {p:uart_rx_i} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_rx_i} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_rx_i} {PAP_IO_NONE} {TRUE}

define_attribute {p:uart_tx_o} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:uart_tx_o} {PAP_IO_LOC} {C24}
define_attribute {p:uart_tx_o} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_tx_o} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_tx_o} {PAP_IO_DRIVE} {8}
define_attribute {p:uart_tx_o} {PAP_IO_NONE} {TRUE}
define_attribute {p:uart_tx_o} {PAP_IO_SLEW} {SLOW}

define_attribute {p:led_o[0]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:led_o[0]} {PAP_IO_LOC} {A20}
define_attribute {p:led_o[0]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led_o[0]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led_o[0]} {PAP_IO_DRIVE} {8}
define_attribute {p:led_o[0]} {PAP_IO_NONE} {TRUE}
define_attribute {p:led_o[0]} {PAP_IO_SLEW} {SLOW}

define_attribute {p:led_o[1]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:led_o[1]} {PAP_IO_LOC} {C18}
define_attribute {p:led_o[1]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led_o[1]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led_o[1]} {PAP_IO_DRIVE} {8}
define_attribute {p:led_o[1]} {PAP_IO_NONE} {TRUE}
define_attribute {p:led_o[1]} {PAP_IO_SLEW} {SLOW}

define_attribute {p:led_o[2]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:led_o[2]} {PAP_IO_LOC} {C19}
define_attribute {p:led_o[2]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led_o[2]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led_o[2]} {PAP_IO_DRIVE} {8}
define_attribute {p:led_o[2]} {PAP_IO_NONE} {TRUE}
define_attribute {p:led_o[2]} {PAP_IO_SLEW} {SLOW}

define_attribute {p:led_o[3]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:led_o[3]} {PAP_IO_LOC} {E18}
define_attribute {p:led_o[3]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led_o[3]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led_o[3]} {PAP_IO_DRIVE} {8}
define_attribute {p:led_o[3]} {PAP_IO_NONE} {TRUE}
define_attribute {p:led_o[3]} {PAP_IO_SLEW} {SLOW}
