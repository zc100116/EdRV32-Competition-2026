# File: edrv32_fpga_media_top.fdc
# Top: edrv32_fpga_media_top; media measurement task V-W1.
# Measurement only, never run on the board. K21 (HDMI input pixel clock) supplies
# clk_mem; D18 (board 27 MHz clock) supplies clk_ext. Both are constrained at 125 MHz.
# clk_ext drives DISP clk_pix, both VIN camera pclks and ETH RX/TX clocks. DISP's
# actual pixel target is 74.25 MHz; this measurement uses the stricter 125 MHz target.
# The two measurement domains are asynchronous; functional CDC stays inside the DUTs.
# stim_i is an external asynchronous input (CLAUDE.md 5.3), sampled independently
# by each domain's serial stimulus register. Pins reuse the CPU/system measurement top.

create_clock -name {clk_mem} [get_ports {clk_mem_i}] -period {8.000} -waveform {0.000 4.000}
create_clock -name {clk_ext} [get_ports {clk_ext_i}] -period {8.000} -waveform {0.000 4.000}
set_clock_groups -name {mem_ext_async} -asynchronous -group [get_clocks {clk_mem}] -group [get_clocks {clk_ext}]
set_false_path -from [get_ports {stim_i}]

define_attribute {p:clk_mem_i} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk_mem_i} {PAP_IO_LOC} {K21}
define_attribute {p:clk_mem_i} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk_mem_i} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk_mem_i} {PAP_IO_NONE} {TRUE}

define_attribute {p:clk_ext_i} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk_ext_i} {PAP_IO_LOC} {D18}
define_attribute {p:clk_ext_i} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk_ext_i} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk_ext_i} {PAP_IO_NONE} {TRUE}

define_attribute {p:rst_n_i} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:rst_n_i} {PAP_IO_LOC} {C22}
define_attribute {p:rst_n_i} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rst_n_i} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rst_n_i} {PAP_IO_NONE} {TRUE}

define_attribute {p:stim_i} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:stim_i} {PAP_IO_LOC} {C23}
define_attribute {p:stim_i} {PAP_IO_VCCIO} {3.3}
define_attribute {p:stim_i} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:stim_i} {PAP_IO_NONE} {TRUE}

define_attribute {p:obs_mem_o} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:obs_mem_o} {PAP_IO_LOC} {A20}
define_attribute {p:obs_mem_o} {PAP_IO_VCCIO} {3.3}
define_attribute {p:obs_mem_o} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:obs_mem_o} {PAP_IO_DRIVE} {8}
define_attribute {p:obs_mem_o} {PAP_IO_NONE} {TRUE}
define_attribute {p:obs_mem_o} {PAP_IO_SLEW} {SLOW}

define_attribute {p:obs_ext_o} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:obs_ext_o} {PAP_IO_LOC} {C18}
define_attribute {p:obs_ext_o} {PAP_IO_VCCIO} {3.3}
define_attribute {p:obs_ext_o} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:obs_ext_o} {PAP_IO_DRIVE} {8}
define_attribute {p:obs_ext_o} {PAP_IO_NONE} {TRUE}
define_attribute {p:obs_ext_o} {PAP_IO_SLEW} {SLOW}

define_attribute {p:irq_obs_o} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:irq_obs_o} {PAP_IO_LOC} {C19}
define_attribute {p:irq_obs_o} {PAP_IO_VCCIO} {3.3}
define_attribute {p:irq_obs_o} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:irq_obs_o} {PAP_IO_DRIVE} {8}
define_attribute {p:irq_obs_o} {PAP_IO_NONE} {TRUE}
define_attribute {p:irq_obs_o} {PAP_IO_SLEW} {SLOW}
