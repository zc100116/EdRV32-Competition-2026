# DISP generic LUT4/FF reference; each physical scan RAM remains a black box.
# Run from repository root: yosys -s verif/unit/disp_reader_gpu/resource.ys
read_verilog -lib -D SIM_MODE -Irtl/include rtl/tech/edrv32_ram_disp_scan.v
read_verilog rtl/common/edrv32_reset_copy.v
read_verilog rtl/media/disp/edrv32_disp_gpu.v
read_verilog rtl/media/disp/edrv32_disp_control.v
read_verilog rtl/media/disp/edrv32_disp_regs_gpu.v
read_verilog rtl/media/disp/edrv32_disp_reader_gpu.v
read_verilog rtl/media/disp/edrv32_disp_scan_gpu.v
read_verilog rtl/media/disp/edrv32_disp_timing.v
read_verilog rtl/media/disp/edrv32_disp_tmds_enc.v
read_verilog rtl/common/edrv32_dma2d_rd.v
read_verilog rtl/common/edrv32_async_fifo_ram.v
read_verilog rtl/common/edrv32_cdc_sync_bit.v
read_verilog rtl/common/edrv32_cdc_handshake.v
read_verilog rtl/common/edrv32_cdc_pulse.v
read_verilog rtl/common/edrv32_cdc_gray_cnt.v
synth -top edrv32_disp_gpu -flatten -lut 4
stat
write_json build/disp_gpu_resource.json
