`verilator_config
// Behavioral testbench and common checker deliberately use blocking queue updates.
lint_off -rule BLKSEQ -file "*/verif/*"
// The compile stub intentionally consumes none of its public inputs.
lint_off -rule UNUSEDSIGNAL -file "*/vin/selftest/edrv32_vin.sv"
// Shared interfaces expose all sixteen APB slots; this bench drives slot 1.
lint_off -rule UNUSEDSIGNAL -file "*/common/edrv32_apb_if.sv"
// The shared checker uses an integer to index its fixed sixteen-entry table.
lint_off -rule UNUSEDSIGNAL -file "*/common/edrv32_axi256_checker.sv"
// Tool version 5.020 does not account for class member uses across class handles.
lint_off -rule UNUSEDSIGNAL -file "*/vin/edrv32_vin_reference_pkg.sv"
lint_off -rule UNDRIVEN -file "*/vin/edrv32_vin_reference_pkg.sv"
// Both reference classes are intentionally scoped inside their one package.
lint_off -rule DECLFILENAME -file "*/vin/edrv32_vin_reference_pkg.sv"
