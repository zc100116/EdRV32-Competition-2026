`verilator_config
// Behavioral queues and clocks intentionally use blocking assignment in testbenches.
lint_off -rule BLKSEQ -file "*/verif/*"
// Reused common BFMs contain packed fields unused by some channel drivers.
lint_off -rule UNUSEDSIGNAL -file "*/verif/common/edrv32_axi256_master.sv"
lint_off -rule UNUSEDSIGNAL -file "*/verif/common/edrv32_axi256_checker.sv"
// The NB connects slot zero of the shared sixteen-slot APB observation interface.
lint_off -rule UNUSEDSIGNAL -file "*/verif/common/edrv32_apb_if.sv"
// The bench samples the DUT's asynchronous resets synchronously only to count cycles.
lint_off -rule SYNCASYNCNET -file "*/verif/block/npu/tb_npu.sv"
