+/* Reference: https://www.nesdev.org/wiki/MMC3#Bank_select
+ * Mode changes rewire both windows immediately; retain every bank register.
+ */
+static void map4_sync(void)
+{
+   uint32 base = (command & 0x80) ? 0x1000 : 0;
+   int fixed = mmc_getinfo()->rom_banks * 2 - 2;
+   mmc_bankrom(8, 0x8000, (command & 0x40) ? fixed : banks[6]);
+   mmc_bankrom(8, 0xA000, banks[7]);
+   mmc_bankrom(8, 0xC000, (command & 0x40) ? banks[6] : fixed);
+   mmc_bankrom(8, 0xE000, MMC_LASTBANK);
+   mmc_bankvrom(1, base ^ 0x0000, banks[0] & 0xFE);
+   mmc_bankvrom(1, base ^ 0x0400, banks[0] | 1);
+   mmc_bankvrom(1, base ^ 0x0800, banks[1] & 0xFE);
+   mmc_bankvrom(1, base ^ 0x0C00, banks[1] | 1);
+   for (int i = 2; i < 6; ++i)
+      mmc_bankvrom(1, base ^ (0x1000 + (i - 2) * 0x400), banks[i]);
+}
 
