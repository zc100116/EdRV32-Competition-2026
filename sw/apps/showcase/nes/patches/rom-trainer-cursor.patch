iNES trainer: advance the caller's ROM cursor past the 512-byte trainer.
Upstream advanced only the local double pointer, so PRG started inside the trainer.

--- a/nes/nes_rom.c
+++ b/nes/nes_rom.c
@@ -154,7 +154,7 @@
    {
 //      fread(rominfo->sram + TRAINER_OFFSET, TRAINER_LENGTH, 1, fp);
       memcpy(rominfo->sram + TRAINER_OFFSET, *rom, TRAINER_LENGTH);
-      rom+=TRAINER_LENGTH;
+      *rom+=TRAINER_LENGTH;
       log_printf("Read in trainer at $7000\n");
    }
 }
