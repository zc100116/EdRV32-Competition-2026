--- a/nes/nes.c
+++ b/nes/nes.c
@@ -262,6 +262,7 @@
    if (nes.fiq_occurred)
    {
       nes.fiq_occurred = false;
+      nes6502_setirq(NES6502_IRQ_FRAME, false);
       return 0x40;
    }
 
@@ -271,6 +272,14 @@
 void nes_setfiq(uint8 value)
 {
    nes.fiq_state = value;
+   /* $4017 bit 6 and a $4015 read acknowledge the frame IRQ line.
+    * Reference: https://www.nesdev.org/wiki/APU#Status_($4015)
+    */
+   if (value & 0x40)
+   {
+      nes.fiq_occurred = false;
+      nes6502_setirq(NES6502_IRQ_FRAME, false);
+   }
    nes.fiq_cycles = (int) NES_FIQ_PERIOD;
 }
 
@@ -283,7 +292,7 @@
       if (0 == (nes.fiq_state & 0xC0))
       {
          nes.fiq_occurred = true;
-         nes6502_irq();
+         nes6502_setirq(NES6502_IRQ_FRAME, true);
       }
    }
 }
