+/* Independently held APU/mapper lines remain asserted until acknowledged.
+ * The legacy nes6502_irq() pulse remains available to other upstream mappers.
+ */
+void nes6502_setirq(uint8 source, bool asserted)
+{
+   if (asserted)
+      cpu.irq_lines |= source;
+   else
+      cpu.irq_lines &= ~source;
+}
