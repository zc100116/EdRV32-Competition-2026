+
+/* Reference: https://www.nesdev.org/wiki/MMC3#IRQ_Specifics
+ * The counter clocks even while IRQ output is disabled. Zero reloads on the
+ * next clock; MMC3B/C asserts IRQ whenever the resulting counter is zero.
+ * nofrendo supplies scanline clocks, not individual filtered PPU A12 edges.
+ */
+static void map4_hblank(int vblank)
+{
+   if (vblank || !ppu_enabled())
+      return;
+
+   if (irq.reset || irq.counter == 0)
       irq.counter = irq.latch;
