--- a/mappers/map004.c
+++ b/mappers/map004.c
@@ -40,6 +40,18 @@
 /* Reference: https://www.nesdev.org/wiki/MMC3#Bank_select
  * Mode changes rewire both windows immediately; retain every bank register.
  */
+/* TGROM/TNROM CHR-RAM uses the same bank address lines as CHR-ROM.
+ * Upstream mmc_bankvrom() returns without mapping a RAM-only cartridge.
+ * Reference: https://www.nesdev.org/wiki/MMC3#Banks
+ */
+static void map4_bankchr(int size, uint32 address, int bank)
+{
+   if (mmc_getinfo()->vrom_banks)
+      mmc_bankvrom(size, address, bank);
+   else
+      ppu_setpage(1, address >> 10, mmc_getinfo()->vram + (bank & 7) * 1024 - address);
+}
+
 static void map4_sync(void)
 {
    uint32 base = (command & 0x80) ? 0x1000 : 0;
@@ -48,12 +60,12 @@
    mmc_bankrom(8, 0xA000, banks[7]);
    mmc_bankrom(8, 0xC000, (command & 0x40) ? banks[6] : fixed);
    mmc_bankrom(8, 0xE000, MMC_LASTBANK);
-   mmc_bankvrom(1, base ^ 0x0000, banks[0] & 0xFE);
-   mmc_bankvrom(1, base ^ 0x0400, banks[0] | 1);
-   mmc_bankvrom(1, base ^ 0x0800, banks[1] & 0xFE);
-   mmc_bankvrom(1, base ^ 0x0C00, banks[1] | 1);
+   map4_bankchr(1, base ^ 0x0000, banks[0] & 0xFE);
+   map4_bankchr(1, base ^ 0x0400, banks[0] | 1);
+   map4_bankchr(1, base ^ 0x0800, banks[1] & 0xFE);
+   map4_bankchr(1, base ^ 0x0C00, banks[1] | 1);
    for (int i = 2; i < 6; ++i)
-      mmc_bankvrom(1, base ^ (0x1000 + (i - 2) * 0x400), banks[i]);
